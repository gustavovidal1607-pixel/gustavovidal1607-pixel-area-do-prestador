# Banco Postgres (Neon). Sem esta variável o sistema roda em modo local (dados-local/).
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Vercel Blob (loja PRIVADA) — onde ficam os PDFs de protocolo e repasse.
# Sem ela, os PDFs vão para dados-local/arquivos.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Primeiro acesso da equipe Faturas Med: criado sozinho se ainda não existir
# nenhum usuário do perfil "faturas". Depois pode trocar a senha pelo sistema.
ADMIN_LOGIN=gustavo
ADMIN_NOME=Gustavo Vidal
ADMIN_SENHA=troque-esta-senha

# Opcional: token para o sync/sincronizar.py entrar sem login de equipe
# (cabeçalho X-Sync-Token). Sem ele, o script entra com --login de um usuário da equipe.
# SYNC_TOKEN=
